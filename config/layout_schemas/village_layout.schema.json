{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Village Layout",
  "type": "object",
  "required": ["layoutName", "player", "objects"],
  "properties": {
    "layoutName": {
      "type": "string",
      "minLength": 1
    },
    "player": {
      "type": "object",
      "required": ["position", "rotation"],
      "properties": {
        "position": {
          "$ref": "#/$defs/vector3"
        },
        "rotation": {
          "$ref": "#/$defs/vector3"
        }
      },
      "additionalProperties": false
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "assetId", "position", "rotation", "scale"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "assetId": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "$ref": "#/$defs/vector3"
          },
          "rotation": {
            "$ref": "#/$defs/vector3"
          },
          "scale": {
            "$ref": "#/$defs/vector3"
          },
          "footprint": {
            "$ref": "#/$defs/footprint"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "vector3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "footprint": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "radius"],
          "properties": {
            "type": {
              "const": "circle"
            },
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "offsetX": {
              "type": "number"
            },
            "offsetZ": {
              "type": "number"
            },
            "rotationOffset": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "width", "depth"],
          "properties": {
            "type": {
              "const": "rect"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "depth": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "offsetX": {
              "type": "number"
            },
            "offsetZ": {
              "type": "number"
            },
            "rotationOffset": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
