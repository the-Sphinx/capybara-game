{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Village Layout",
  "type": "object",
  "required": ["layoutName", "objects"],
  "properties": {
    "layoutName": {
      "type": "string",
      "minLength": 1
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "assetId", "position", "rotation", "scale"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "assetId": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "$ref": "#/$defs/vector3"
          },
          "rotation": {
            "$ref": "#/$defs/vector3"
          },
          "scale": {
            "$ref": "#/$defs/vector3"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "vector3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
