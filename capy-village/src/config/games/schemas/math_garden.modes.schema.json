{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capy-village/src/config/games/schemas/math_garden.modes.schema.json",
  "title": "Math Garden Modes",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "title", "prompt", "params"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "const": "math.collection.divisibility" },
          "title": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": ["divisor", "numberRange", "pointsPerCorrect", "wrongPenalty", "wrongFeedback"],
            "properties": {
              "divisor": { "type": "integer", "minimum": 1 },
              "remainder": { "type": "integer", "minimum": 0 },
              "numberRange": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "integer" }
              },
              "pointsPerCorrect": { "type": "number" },
              "wrongPenalty": { "type": "number", "minimum": 0 },
              "wrongFeedback": { "type": "string" }
            }
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "title", "prompt", "params"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "const": "math.answer.operation" },
          "title": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation", "numberRange", "answerCount", "pointsPerCorrect", "wrongPenalty", "wrongFeedback"],
            "properties": {
              "operation": {
                "type": "string",
                "enum": ["addition", "subtraction", "mixed"]
              },
              "numberRange": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "integer" }
              },
              "answerCount": { "type": "integer", "minimum": 2 },
              "pointsPerCorrect": { "type": "number" },
              "wrongPenalty": { "type": "number", "minimum": 0 },
              "wrongFeedback": { "type": "string" }
            }
          }
        }
      }
    ]
  }
}
