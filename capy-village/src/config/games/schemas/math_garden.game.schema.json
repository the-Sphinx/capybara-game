{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Math Garden game config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "label",
    "schemaVersion",
    "worldIds",
    "worldSelect",
    "levelSelect",
    "arcade",
    "starters"
  ],
  "properties": {
    "id": {
      "const": "math_garden"
    },
    "label": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": true
    },
    "worldIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "worldSelect": {
      "type": "object",
      "additionalProperties": true
    },
    "levelSelect": {
      "type": "object",
      "additionalProperties": true
    },
    "starters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "activityType"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "activityType": {
            "type": "string",
            "enum": [
              "collect_stream",
              "answer_prompt"
            ]
          },
          "objective": {
            "type": "object",
            "additionalProperties": true
          },
          "content": {
            "type": "object",
            "additionalProperties": true
          },
          "difficulty": {
            "type": "object",
            "additionalProperties": true
          },
          "scoring": {
            "type": "object",
            "additionalProperties": true
          },
          "presentation": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "arcade": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "activities": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "label",
                  "activityType",
                  "objective",
                  "content",
                  "difficulty",
                  "scoring",
                  "presentation"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "schemaVersion": {
                    "type": "number"
                  },
                  "activityType": {
                    "const": "collect_stream"
                  },
                  "objective": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "rule": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "parity",
                              "modulo",
                              "prime",
                              "comparison",
                              "compound"
                            ]
                          },
                          "parity": {
                            "type": "string",
                            "enum": [
                              "even",
                              "odd"
                            ]
                          },
                          "mod": {
                            "type": "number"
                          },
                          "remainder": {
                            "type": "number"
                          },
                          "comparison": {
                            "type": "string",
                            "enum": [
                              "less_than_or_equal",
                              "greater_than_or_equal"
                            ]
                          },
                          "value": {
                            "type": "number"
                          },
                          "matcher": {
                            "type": "object"
                          }
                        },
                        "required": [
                          "type"
                        ]
                      }
                    },
                    "required": [
                      "rule"
                    ]
                  },
                  "content": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "domain": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "numbers"
                            ]
                          },
                          "range": {
                            "type": [
                              "array",
                              "null"
                            ],
                            "minItems": 2,
                            "maxItems": 2,
                            "items": {
                              "type": "number"
                            }
                          }
                        },
                        "required": [
                          "kind",
                          "range"
                        ]
                      },
                      "itemCount": {
                        "type": "number"
                      },
                      "spawnDelayRange": {
                        "type": [
                          "array",
                          "null"
                        ],
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                          "type": "number"
                        }
                      },
                      "fallSpeedRange": {
                        "type": [
                          "array",
                          "null"
                        ],
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                          "type": "number"
                        }
                      }
                    },
                    "required": [
                      "domain",
                      "itemCount"
                    ]
                  },
                  "difficulty": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "timeLimit": {
                        "type": "number"
                      },
                      "goal": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "catchCount",
                              "score",
                              "combo"
                            ]
                          },
                          "value": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "type",
                          "value"
                        ]
                      },
                      "phases": {
                        "type": "array"
                      }
                    },
                    "required": [
                      "timeLimit",
                      "goal"
                    ]
                  },
                  "scoring": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "pointsPerCorrect": {
                        "type": "number"
                      },
                      "wrongPenalty": {
                        "type": "number"
                      },
                      "wrongFeedback": {
                        "type": "string"
                      },
                      "clearReward": {
                        "type": "number"
                      },
                      "bonusTiers": {
                        "type": "array"
                      }
                    },
                    "required": [
                      "pointsPerCorrect",
                      "wrongPenalty",
                      "clearReward"
                    ]
                  },
                  "presentation": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "prompt": {
                        "type": "string"
                      },
                      "hint": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "prompt"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "label",
                  "activityType",
                  "objective",
                  "content",
                  "difficulty",
                  "scoring",
                  "presentation"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "schemaVersion": {
                    "type": "number"
                  },
                  "activityType": {
                    "const": "answer_prompt"
                  },
                  "objective": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "operation": {
                        "type": "string",
                        "enum": [
                          "addition",
                          "subtraction",
                          "multiplication",
                          "division",
                          "mixed"
                        ]
                      }
                    },
                    "required": [
                      "operation"
                    ]
                  },
                  "content": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "numberRange": {
                        "type": [
                          "array",
                          "null"
                        ],
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                          "type": "number"
                        }
                      },
                      "answerCount": {
                        "type": "number"
                      },
                      "fixedOperand": {
                        "type": "number"
                      },
                      "targetValue": {
                        "type": "number"
                      },
                      "leftRange": {
                        "type": [
                          "array",
                          "null"
                        ],
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                          "type": "number"
                        }
                      },
                      "rightRange": {
                        "type": [
                          "array",
                          "null"
                        ],
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                          "type": "number"
                        }
                      }
                    },
                    "required": [
                      "numberRange",
                      "answerCount"
                    ]
                  },
                  "difficulty": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "timeLimit": {
                        "type": "number"
                      },
                      "goal": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "correctAnswers",
                              "score",
                              "combo"
                            ]
                          },
                          "value": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "type",
                          "value"
                        ]
                      }
                    },
                    "required": [
                      "timeLimit",
                      "goal"
                    ]
                  },
                  "scoring": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "pointsPerCorrect": {
                        "type": "number"
                      },
                      "wrongPenalty": {
                        "type": "number"
                      },
                      "wrongFeedback": {
                        "type": "string"
                      },
                      "clearReward": {
                        "type": "number"
                      },
                      "bonusTiers": {
                        "type": "array"
                      }
                    },
                    "required": [
                      "pointsPerCorrect",
                      "wrongPenalty",
                      "clearReward"
                    ]
                  },
                  "presentation": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "prompt": {
                        "type": "string"
                      },
                      "hint": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "prompt"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
