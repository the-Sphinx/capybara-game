{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "math_garden game manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "recipes",
    "worlds"
  ],
  "properties": {
    "id": {
      "const": "math_garden"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recipeId": {
          "type": "string"
        },
        "timeLimit": {
          "type": "number"
        },
        "goal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "value": {
              "type": "number"
            }
          }
        },
        "clearReward": {
          "type": "number"
        },
        "bonusTiers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "threshold",
              "reward"
            ],
            "properties": {
              "threshold": {
                "type": "number"
              },
              "reward": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "worldSelect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backgroundPath": {
          "type": "string"
        },
        "levelSelectBackgroundPath": {
          "type": "string"
        }
      }
    },
    "levelSelect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backgroundPath": {
          "type": "string"
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slot",
              "x",
              "y",
              "r"
            ],
            "properties": {
              "slot": {
                "type": "number"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "r": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "arcade": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "recipeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "recipes": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "title",
              "prompt",
              "rules",
              "scoring"
            ],
            "properties": {
              "kind": {
                "const": "collect_numbers"
              },
              "title": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "rules": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "matcher",
                  "numberRange"
                ],
                "properties": {
                  "matcher": {
                    "type": "string",
                    "enum": [
                      "even",
                      "odd",
                      "prime",
                      "divisible_by"
                    ]
                  },
                  "numberRange": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  },
                  "divisor": {
                    "type": "number"
                  },
                  "remainder": {
                    "type": "number"
                  },
                  "itemCount": {
                    "type": "number"
                  }
                }
              },
              "scoring": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pointsPerCorrect",
                  "wrongPenalty"
                ],
                "properties": {
                  "pointsPerCorrect": {
                    "type": "number"
                  },
                  "wrongPenalty": {
                    "type": "number"
                  },
                  "wrongFeedback": {
                    "type": "string"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "title",
              "prompt",
              "rules",
              "scoring"
            ],
            "properties": {
              "kind": {
                "const": "answer_equation"
              },
              "title": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "rules": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "operation",
                  "numberRange",
                  "answerCount"
                ],
                "properties": {
                  "operation": {
                    "type": "string",
                    "enum": [
                      "addition",
                      "subtraction",
                      "mixed"
                    ]
                  },
                  "numberRange": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  },
                  "answerCount": {
                    "type": "number"
                  }
                }
              },
              "scoring": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pointsPerCorrect",
                  "wrongPenalty"
                ],
                "properties": {
                  "pointsPerCorrect": {
                    "type": "number"
                  },
                  "wrongPenalty": {
                    "type": "number"
                  },
                  "wrongFeedback": {
                    "type": "string"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "worlds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "levels"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "unlockRequirementText": {
            "type": "string"
          },
          "signBox": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "w",
              "h"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              }
            }
          },
          "clickBox": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "w",
              "h"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              }
            }
          },
          "defaults": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "recipeId": {
                "type": "string"
              },
              "timeLimit": {
                "type": "number"
              },
              "goal": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "value"
                ],
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "value": {
                    "type": "number"
                  }
                }
              },
              "clearReward": {
                "type": "number"
              },
              "bonusTiers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "threshold",
                    "reward"
                  ],
                  "properties": {
                    "threshold": {
                      "type": "number"
                    },
                    "reward": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          "levels": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "levelId",
                "levelNum",
                "label",
                "recipeId"
              ],
              "properties": {
                "levelId": {
                  "type": "string"
                },
                "levelNum": {
                  "type": "number"
                },
                "label": {
                  "type": "string"
                },
                "slot": {
                  "type": "number"
                },
                "recipeId": {
                  "type": "string"
                },
                "timeLimit": {
                  "type": "number"
                },
                "goal": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "value"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "value": {
                      "type": "number"
                    }
                  }
                },
                "clearReward": {
                  "type": "number"
                },
                "bonusTiers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "threshold",
                      "reward"
                    ],
                    "properties": {
                      "threshold": {
                        "type": "number"
                      },
                      "reward": {
                        "type": "number"
                      }
                    }
                  }
                },
                "overrides": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "rules": {
                      "type": "object"
                    },
                    "scoring": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
