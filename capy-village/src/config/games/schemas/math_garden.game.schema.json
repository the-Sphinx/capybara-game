{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "math_garden game manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "worldIds",
    "recipes"
  ],
  "properties": {
    "id": {
      "const": "math_garden"
    },
    "worldIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recipeId": {
          "type": "string"
        },
        "timeLimit": {
          "type": "number"
        },
        "goal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "value": {
              "type": "number"
            }
          }
        },
        "clearReward": {
          "type": "number"
        },
        "bonusTiers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "threshold",
              "reward"
            ],
            "properties": {
              "threshold": {
                "type": "number"
              },
              "reward": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "worldSelect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backgroundPath": {
          "type": "string"
        }
      }
    },
    "levelSelect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backgroundPath": {
          "type": "string"
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slot",
              "x",
              "y",
              "r"
            ],
            "properties": {
              "slot": {
                "type": "number"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "r": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "arcade": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "recipeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "recipes": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "title",
              "prompt",
              "rules",
              "scoring"
            ],
            "properties": {
              "kind": {
                "const": "collect_numbers"
              },
              "title": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "rules": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "numberRange"
                ],
                "properties": {
                  "numberRange": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  },
                  "matcher": {
                    "oneOf": [
                      {
                        "type": "string",
                        "enum": [
                          "even",
                          "odd",
                          "prime",
                          "divisible_by"
                        ]
                      },
                      {
                        "type": "object"
                      }
                    ]
                  },
                  "divisor": {
                    "type": "number"
                  },
                  "remainder": {
                    "type": "number"
                  },
                  "itemCount": {
                    "type": "number"
                  },
                  "spawnDelayRange": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  },
                  "fallSpeedRange": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  },
                  "phases": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              },
              "scoring": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pointsPerCorrect",
                  "wrongPenalty"
                ],
                "properties": {
                  "pointsPerCorrect": {
                    "type": "number"
                  },
                  "wrongPenalty": {
                    "type": "number"
                  },
                  "wrongFeedback": {
                    "type": "string"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "title",
              "prompt",
              "rules",
              "scoring"
            ],
            "properties": {
              "kind": {
                "const": "answer_equation"
              },
              "title": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "rules": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "operation",
                  "numberRange",
                  "answerCount"
                ],
                "properties": {
                  "operation": {
                    "type": "string",
                    "enum": [
                      "addition",
                      "subtraction",
                      "multiplication",
                      "division",
                      "mixed"
                    ]
                  },
                  "numberRange": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  },
                  "answerCount": {
                    "type": "number"
                  },
                  "fixedOperand": {
                    "type": "number"
                  },
                  "targetValue": {
                    "type": "number"
                  },
                  "leftRange": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  },
                  "rightRange": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  }
                }
              },
              "scoring": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pointsPerCorrect",
                  "wrongPenalty"
                ],
                "properties": {
                  "pointsPerCorrect": {
                    "type": "number"
                  },
                  "wrongPenalty": {
                    "type": "number"
                  },
                  "wrongFeedback": {
                    "type": "string"
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
