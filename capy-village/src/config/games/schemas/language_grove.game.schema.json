{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "language_grove game manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "recipes",
    "worlds"
  ],
  "properties": {
    "id": {
      "const": "language_grove"
    },
    "defaults": {
      "type": "object"
    },
    "worldSelect": {
      "type": "object"
    },
    "levelSelect": {
      "type": "object"
    },
    "arcade": {
      "type": "object"
    },
    "recipes": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "title",
              "prompt",
              "rules",
              "scoring"
            ],
            "properties": {
              "kind": {
                "const": "collect_letters"
              },
              "title": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "rules": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "letterSet",
                  "fallSpeed"
                ],
                "properties": {
                  "letterSet": {},
                  "fallSpeed": {},
                  "targetWord": {},
                  "itemCount": {}
                }
              },
              "scoring": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pointsPerCorrect",
                  "wrongPenalty"
                ],
                "properties": {
                  "pointsPerCorrect": {},
                  "wrongPenalty": {}
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "title",
              "prompt",
              "rules",
              "scoring"
            ],
            "properties": {
              "kind": {
                "const": "collect_category_words"
              },
              "title": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "rules": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "category",
                  "fallSpeed"
                ],
                "properties": {
                  "category": {},
                  "fallSpeed": {},
                  "itemCount": {}
                }
              },
              "scoring": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pointsPerCorrect",
                  "wrongPenalty"
                ],
                "properties": {
                  "pointsPerCorrect": {},
                  "wrongPenalty": {}
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "title",
              "prompt",
              "rules",
              "scoring"
            ],
            "properties": {
              "kind": {
                "const": "choice_prompt"
              },
              "title": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "rules": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "promptSet",
                  "fallSpeed",
                  "answerCount"
                ],
                "properties": {
                  "promptSet": {},
                  "fallSpeed": {},
                  "answerCount": {}
                }
              },
              "scoring": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pointsPerCorrect",
                  "wrongPenalty"
                ],
                "properties": {
                  "pointsPerCorrect": {},
                  "wrongPenalty": {}
                }
              }
            }
          }
        ]
      }
    },
    "worlds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "levels"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "unlockRequirementText": {
            "type": "string"
          },
          "signBox": {
            "type": "object"
          },
          "clickBox": {
            "type": "object"
          },
          "defaults": {
            "type": "object"
          },
          "levels": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
