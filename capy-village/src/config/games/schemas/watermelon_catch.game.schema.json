{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "watermelon_catch game manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "worldIds",
    "recipes"
  ],
  "properties": {
    "id": {
      "const": "watermelon_catch"
    },
    "worldIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recipeId": {
          "type": "string"
        },
        "timeLimit": {
          "type": "number"
        },
        "goal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "value": {
              "type": "number"
            }
          }
        },
        "clearReward": {
          "type": "number"
        },
        "bonusTiers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "threshold",
              "reward"
            ],
            "properties": {
              "threshold": {
                "type": "number"
              },
              "reward": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "worldSelect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backgroundPath": {
          "type": "string"
        }
      }
    },
    "levelSelect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backgroundPath": {
          "type": "string"
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slot",
              "x",
              "y",
              "r"
            ],
            "properties": {
              "slot": {
                "type": "number"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "r": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "arcade": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "recipeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "recipes": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "title",
              "prompt",
              "rules",
              "scoring"
            ],
            "properties": {
              "kind": {
                "const": "classic_collect"
              },
              "title": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "rules": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "itemValues",
                  "timeBonuses",
                  "bombPenalty"
                ],
                "properties": {
                  "itemValues": {
                    "type": "object"
                  },
                  "timeBonuses": {
                    "type": "object"
                  },
                  "bombPenalty": {
                    "type": "number"
                  },
                  "fallSpeedMult": {
                    "type": "number"
                  },
                  "spawnRateMult": {
                    "type": "number"
                  },
                  "specialItems": {
                    "type": "object"
                  }
                }
              },
              "scoring": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {
                  "wrongPenalty": {
                    "type": "number"
                  },
                  "wrongFeedback": {
                    "type": "string"
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
